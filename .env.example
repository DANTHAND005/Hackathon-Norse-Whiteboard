# Copy this file to .env and fill in the two values. The .env file is private and never goes to GitHub.
# Both of these are PUBLIC values (safe in the website). Find them in Supabase:
#   Project Settings > API Keys  (Project URL, and the "publishable" / anon key)
# Never put the Gemini key, the Canvas address, or a Supabase "secret" / service_role key here.
# Those go in Supabase Edge Function secrets; see docs/SETUP.md.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
